# =============================================================================
# Trade Portal — copy this file to `.env` and fill in local values.
# Never commit `.env`. Next.js loads it automatically for `npm run dev`.
# =============================================================================

# Primary database URL
DATABASE_URL="mysql://root:root123@localhost:3306/export_portal"

# Optional alias — if unset, the app falls back to DATABASE_URL.
MYSQL_DATABASE_URL="mysql://root:root123@localhost:3306/export_portal"

# Local MySQL does not use TLS. Set true only for remote/managed MySQL.
MYSQL_SSL=false
MYSQL_CONNECTION_LIMIT=10

# Signed session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MYSQL_SESSION_SECRET="replace-with-at-least-32-random-characters"

# Force the MySQL backend (use `mock` only for offline browser demos).
NEXT_PUBLIC_PORTAL_BACKEND=mysql

# Show clickable demo accounts on /login (local only — turn off for real deploys).
NEXT_PUBLIC_SHOW_DEMO_LOGINS=true

# First super-admin, used only by `npm run db:setup`. Change after first login.
MYSQL_BOOTSTRAP_ADMIN_EMAIL="admin@mnfsr.gov.pk"
MYSQL_BOOTSTRAP_ADMIN_NAME="Portal Super Admin"
MYSQL_BOOTSTRAP_ADMIN_PASSWORD="change-me-to-12-plus-chars"
